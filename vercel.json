  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?page=sitemap" },
    { "source": "/:lang(bg|en|de|es|fr|ru)/recipes", "destination": "/api/seo?page=hub&lang=:lang" },
