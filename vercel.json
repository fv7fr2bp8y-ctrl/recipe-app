{
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "tastemaster.eu" }], "destination": "https://tastemaster365.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.tastemaster.eu" }], "destination": "https://tastemaster365.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.tastemaster365.com" }], "destination": "https://tastemaster365.com/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?page=sitemap" },
    { "source": "/:lang(bg|en|de|es|fr|ru)/recipes", "destination": "/api/seo?page=hub&lang=:lang" },
    { "source": "/:lang(bg|en|de|es|fr|ru)/recipe/:slug", "destination": "/api/seo?page=recipe&lang=:lang&slug=:slug" }
  ]
}
